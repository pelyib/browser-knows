{
    "manifest_version": 3,
    "name": "Browser knows",
    "description": "Knowledge base immediately in your browser new tab",
    "version": "0.0.1",
    "icons": {
        "128": "assets/icons/128.png"
    },
    "chrome_url_overrides": {
        "newtab": "index.html"
    },
    "background": {
        "scripts": ["assets/js/background.js"]
    },
    "options_ui": {
        "page": "options.html",
        "open_in_tab": false
    },
    "permissions": [
        "bookmarks",
        "storage"
    ]
}
